```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database
db.sqlite3
*.db

# Environment
.env
.env.local
.env.*
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
.coverage
coverage/
htmlcov/

# Pytest
.pytest_cache/

# Migrations (keep migration files themselves, but ignore Python cache in migrations)
**/__pycache__/
**/*.pyc
```