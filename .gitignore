```gitignore
# Python compiled files
*.pyc
__pycache__/

# Database
db.sqlite3

# Environment variables
.env
.env.local
.env.*

# Dependencies
.venv/
venv/
node_modules/

# Logs
*.log

# Coverage
.coverage
coverage/
htmlcov/

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Build artifacts
build/
dist/
target/
.mypy_cache/
.pytest_cache/
.gradle/
```